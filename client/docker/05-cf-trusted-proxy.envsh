#!/bin/sh

set -eu

case "${CF_TRUSTED_PROXY:-unix:}" in
    auto)
        gateway="$(
            ip -4 route show default 2>/dev/null |
            awk '/default/ { print $3; exit }'
        )"

        if [ -z "$gateway" ]; then
            echo >&2 "ERROR: failed to detect Docker gateway for CF_TRUSTED_PROXY=auto"
            return 1
        fi

        CF_TRUSTED_PROXY="$gateway"
        export CF_TRUSTED_PROXY
        ;;

    unix:)
        ;;

    *)
        ;;
esac
