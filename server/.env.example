# ============================================
# Server 환경변수 예시
# ============================================

# 실행 환경: development | production
ENV=development

# 필수: 인증
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_EMAIL=admin@example.com

# 데이터베이스
# 방법 1) DATABASE_URL 직접 사용 (로컬 기본)
DATABASE_URL=sqlite+aiosqlite:///./blog.db
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/blog_db

# 방법 2) 개별 파라미터 사용 (설정 시 DATABASE_URL보다 우선)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=blog_user
# DB_PASSWORD=blog_password
# DB_NAME=blog_db

# Redis (Rate Limiting, 블랙리스트, 조회수 중복 방지)
# 로그인/인증에는 Redis가 필요합니다. 장애 시 503으로 거절합니다.
REDIS_URL=redis://localhost:6379/0

# CORS 허용 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 이미지 URL base (로컬 단독 실행 시 서버 주소 권장)
BASE_URL=http://localhost:8000

# Open Graph용 사이트 정보
SITE_URL=https://yourdomain.com
SITE_NAME=YSG Blog

# Direct development: empty (ignore forwarded headers). Compose sets this to client.
TRUSTED_PROXY_HOST=
