# ============================================
# docker-compose 환경변수 (필수 항목은 반드시 설정)
# 이 파일을 .env로 복사한 후 값을 설정하세요
# ============================================

# --- 필수 (미설정 시 docker compose up 실패) ---
POSTGRES_PASSWORD=your-secure-db-password
REDIS_PASSWORD=your-secure-redis-password
SECRET_KEY=your-super-secret-jwt-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# --- 선택 ---
POSTGRES_DB=blog_db
POSTGRES_USER=blog_user
ADMIN_EMAIL=admin@example.com
SITE_URL=https://yourdomain.com
SITE_NAME=YSG Blog
TIMEZONE=Asia/Seoul

# Direct deployment: 0.0.0.0.
# Same-host host-network cloudflared: 127.0.0.1.
BIND_ADDRESS=0.0.0.0

# unix: = trust no TCP proxy
# auto = detect and trust the Docker default gateway
# exact IP = trust only that TCP peer
CF_TRUSTED_PROXY=unix:

# MCP is disabled until clients and HTTPS origin have been configured.
MCP_ENABLED=false
MCP_OAUTH_MODE=local
# Replace the sample ID/callback with the exact values supplied by the client.
# The JSON must remain on one line. No wildcard callback URLs are supported.
MCP_OAUTH_CLIENTS='[{"client_id":"blog-local-client","redirect_uris":["http://127.0.0.1:8765/callback"],"token_endpoint_auth_method":"none","scope":"blog:read images:read blog:read_private images:read_private blog:propose images:propose"}]'
# Optional dynamic registration: comma-separated exact callback URLs.
MCP_OAUTH_REGISTRATION_REDIRECTS=
